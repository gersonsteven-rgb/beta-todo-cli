# Copiá este archivo como .env y ajustá los valores.

# Puerto del servidor
PORT=3000

# URL pública (https) del servidor. Vacía = se usa la IP de la red local.
# Durante el demo podés pegar aquí la URL de un túnel (cloudflared/ngrok)
# o configurarla desde el panel → Ajustes → URL pública.
PUBLIC_URL=

# Usuario dueño que se crea la primera vez que arranca (cambiá la contraseña para un piloto real)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=demo1234

# Secreto para firmar las sesiones (si se deja vacío se genera uno en data/)
SESSION_SECRET=

# Carpeta de datos (base SQLite, logo subido). Útil para correr varios clientes en la misma máquina.
DATA_DIR=data

# ---------- Apple Wallet (requiere Apple Developer Program) ----------
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_SIGNER_CERT=certs/apple/signerCert.pem
APPLE_SIGNER_KEY=certs/apple/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=certs/apple/wwdr.pem

# ---------- Google Wallet (Google Pay & Wallet Console) ----------
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=certs/google/service-account.json
# Sufijo del id de la clase de lealtad (uno por negocio)
GOOGLE_WALLET_CLASS_SUFFIX=fusiontruck_loyalty
# Opcional: URL pública https del logo (si PUBLIC_URL no es https)
GOOGLE_WALLET_LOGO_URL=

# ---------- Marca del proveedor (se muestra discretamente; vacío = oculto) ----------
VENDOR_NAME=HoraCeroIA
VENDOR_URL=https://horaceroia.com
